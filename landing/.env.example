# Resend API key (https://resend.com → API Keys). Without it, leads are stored but no email is sent.
RESEND_API_KEY=

# Sender address. Until you verify your own domain in Resend, keep the default onboarding sender.
MAIL_FROM=Logix <onboarding@resend.dev>

# The demo link sent to leads
DEMO_URL=https://wasteops-demo-production.up.railway.app/login

# Secret key for exporting collected leads: GET /api/leads?key=...
LEADS_KEY=change-me

# Server port (Railway sets PORT automatically)
PORT=3002

# CORS: which origin may call the API cross-origin (use https://logix.bg when the page is hosted statically)
ALLOWED_ORIGIN=*

# Frontend build-time: absolute API base when the page is NOT served by this Node server
# (e.g. static Apache hosting on logix.bg + API on Railway). Leave empty when same-origin.
# VITE_API_URL=https://your-api.up.railway.app
